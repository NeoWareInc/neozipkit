# Monorepo: link workspace packages (neozipkit ↔ neozip-blockchain)
link-workspace-packages=true

# Jest and similar tools expect hoisted peer deps (pnpm strict layout)
public-hoist-pattern[]=*jest*
public-hoist-pattern[]=@jest/*
public-hoist-pattern[]=*babel*

# Do not auto-install optional Lit peer (pulls ethers v5 / elliptic)
auto-install-peers=false
strict-peer-dependencies=false
