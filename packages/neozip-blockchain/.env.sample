# NeoZip Blockchain Examples - Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# SECURITY WARNING:
# - NEVER commit .env to version control (it's in .gitignore)
# - NEVER use mainnet private keys in examples
# - ONLY use testnet keys with minimal test funds
# - Rotate keys immediately if accidentally exposed

# ============================================================================
# NeoZip Token Service API configuration
# ============================================================================

# Preferred: select network profile (couples chain + Token Service host)
# base-sepolia → https://testnet.token-service.neozip.io  (chain 84532, default)
# base         → https://token-service.neozip.io          (chain 8453)
# TOKEN_SERVICE_NETWORK=base-sepolia
# TOKEN_SERVICE_NETWORK=base

# Optional: explicit NeoZip Token Service base URL (overrides profile host)
# Default when unset: https://testnet.token-service.neozip.io
# TOKEN_SERVICE_URL=https://testnet.token-service.neozip.io
# TOKEN_SERVICE_URL=https://token-service.neozip.io

# Email address for timestamp submissions (stamp-zip.ts)
# Run pnpm verify-email to register/verify; it saves to .env.local as TOKEN_SERVICE_EMAIL
# example: your-email@example.com
TOKEN_SERVICE_EMAIL=

# Optional: POST /auth/register verification email layout (NeoZip Token Service)
# browser (default): web confirm link + 6-digit code — best for scripts and pnpm verify-email
# app: NeoZip deep link + code only (no web link) — desktop / in-app onboarding
# TOKEN_SERVICE_VERIFICATION_DELIVERY=browser
# TOKEN_SERVICE_VERIFICATION_DELIVERY=app

# Optional: numeric chain override (default: 84532 Base Sepolia)
# Prefer TOKEN_SERVICE_NETWORK. Base Sepolia: 84532, Base Mainnet: 8453
TOKEN_SERVICE_CHAIN_ID=84532
# Deprecated alias (still read if TOKEN_SERVICE_CHAIN_ID unset): NEOZIP_CHAIN_ID

# Optional: Enable debug logging for the token service HTTP client
TOKEN_SERVICE_DEBUG=false

# ============================================================================
# NFT Minting (mint-nft.ts, token-create.ts)
# ============================================================================

# Required: Private key for NFT minting operations
# This should be a wallet with testnet ETH for gas fees
# WARNING: Use a separate test wallet, not your main wallet
USER_PRIVATE_KEY=0x...
